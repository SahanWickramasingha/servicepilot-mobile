{
  "name": "servicepilot-admin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8793",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:emulator": "tsx --test --test-concurrency=1 test/firestore.emulator.ts test/decision-email.emulator.ts",
    "build": "wrangler deploy --dry-run --outdir .worker-build"

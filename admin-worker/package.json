  "dependencies": {
    "jose": "^6.1.0",
    "servicepilot-mobile": "file:.."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.2-beta",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "wrangler": "4.155.0"
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep a private own-profile read available for live account-status denial.
    // All other protected operations also require this authoritative session gate.
    function hasActiveSession() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && profileHasActiveAccount(profile) &&
        profile.get("lifecyclePending", false) == false &&
        (!profile.keys().hasAny(["sessionRevokedAt"]) ||
          request.auth.token.auth_time > profile.sessionRevokedAt);
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.role;
    }

    function userAccountStatus(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.accountStatus;
    }

    function userHasActiveAccount(userId) {
      return !get(
        /databases/$(database)/documents/users/$(userId)
      ).data.keys().hasAny(["accountStatus"]) ||
        userAccountStatus(userId) == "active";
    }

    function profileHasActiveAccount(data) {
      return !data.keys().hasAny(["accountStatus"]) ||
        data.accountStatus == "active";
    }

    function isSuperAdmin() {
      return signedIn() &&
        userRole(request.auth.uid) == "super_admin" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isActiveSuperAdmin() {
      return signedIn() &&
        userRole(request.auth.uid) == "super_admin" &&
        userAccountStatus(request.auth.uid) == "active";
    }

    function isActiveDispatcher() {
      return signedIn() &&
        userRole(request.auth.uid) == "dispatcher" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isPublicRegistrationRole() {
      return request.resource.data.role in [
        "customer",
        "technician"
      ];
    }

    function authEmailMatchesProfile() {
      return request.auth.token.email is string &&
        request.resource.data.email == request.auth.token.email;
    }

    function hasRequiredUserFields() {
      return request.resource.data.keys().hasAll([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyCustomerCreateFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyTechnicianCreateFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "specialization",
        "serviceCategoryId",
        "experience",
        "qualifications",
        "certifications",
        "serviceAreas",
        "serviceDivision",
        "technicianApprovalStatus",
        "availability",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasRequiredTechnicianCreateFields() {
      return request.resource.data.keys().hasAll([
        "specialization",
        "experience",
        "qualifications",
        "certifications",
        "serviceDivision",
        "technicianApprovalStatus"
      ]);
    }

    function validPublicUserCreate(userId) {
      return isOwner(userId) &&
        hasRequiredUserFields() &&
        request.resource.data.uid == userId &&
        authEmailMatchesProfile() &&
        isPublicRegistrationRole() &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.emailVerified == false &&
        (
          (
            request.resource.data.role == "customer" &&
            hasOnlyCustomerCreateFields()
          ) ||
          (
            request.resource.data.role == "technician" &&
            hasOnlyTechnicianCreateFields() &&
            hasRequiredTechnicianCreateFields() &&
            request.resource.data.get("availability", "offline") == "offline" &&
            (!request.resource.data.keys().hasAny(["serviceCategoryId"]) || validSelectedTechnicianCategory(request.resource.data)) &&
            request.resource.data.technicianApprovalStatus == "pending"
          )
        );
    }

    function ownerMutableFieldsOnly() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "fullName",
          "phone",
          "address",
          "specialization",
          "serviceCategoryId",
          "experience",
          "qualifications",
          "certifications",
          "serviceAreas",
          "serviceDivision",
          "serviceDistrictIds",
          "serviceAreasByDistrict",
          "emailVerified",
          "updatedAt"
        ]);
    }

    function validOwnerUpdate(userId) {
      return isOwner(userId) &&
        ownerMutableFieldsOnly() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["specialization", "serviceCategoryId"]) ||
          validOwnerCategoryUpdate(userId)) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["serviceDistrictIds", "serviceAreasByDistrict"]) ||
          (resource.data.role == "technician" && validServiceAreas(request.resource.data.get("serviceAreasByDistrict", {}), request.resource.data.get("serviceDistrictIds", [])))
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["serviceDistrictIds"]) ||
          (resource.data.role == "technician" && validServiceDistrictIds(request.resource.data.serviceDistrictIds))
        ) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(["emailVerified"]) ||
          (
            resource.data.emailVerified == false &&
            request.resource.data.emailVerified == true &&
            request.auth.token.email_verified == true
          )
        ) &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "uid",
            "role",
            "technicianApprovalStatus",
            "reviewedBy",
            "reviewedAt",
            "rejectionReason"
          ]);
    }

    function validOwnerCategoryUpdate(userId) {
      let projection = getAfter(/databases/$(database)/documents/technician_map_profiles/$(userId)).data;
      return resource.data.role == "technician" && validSelectedTechnicianCategory(request.resource.data) &&
        projection.serviceCategoryId == request.resource.data.serviceCategoryId &&
        projection.serviceCategory == request.resource.data.specialization && projection.updatedAt == request.time;
    }

    function validTechnicianAvailabilityUpdate(userId) {
      let projection = getAfter(/databases/$(database)/documents/technician_map_profiles/$(userId)).data;
      return isOwner(userId) && isVerifiedApprovedTechnician() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["availability", "updatedAt"]) &&
        request.resource.data.availability in ["available", "busy", "offline"] &&
        request.resource.data.updatedAt == request.time &&
        projection.technicianId == userId && projection.availability == request.resource.data.availability &&
        projection.updatedAt == request.time;
    }

    function validDispatcherTechnicianReview() {
      return isActiveDispatcher() &&
        resource.data.role == "technician" &&
        resource.data.technicianApprovalStatus == "pending" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "technicianApprovalStatus",
            "reviewedBy",
            "reviewedAt",
            "rejectionReason",
            "serviceCategoryId",
            "specialization",
            "updatedAt"
          ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["specialization", "serviceCategoryId"]) ||
          (validSelectedTechnicianCategory(request.resource.data) &&
            request.resource.data.serviceCategoryId == technicianCategoryId(resource.data))) &&
        request.resource.data.technicianApprovalStatus in [
          "approved",
          "rejected"
        ] &&
        (
          request.resource.data.technicianApprovalStatus == "approved" ||
          (
            request.resource.data.technicianApprovalStatus == "rejected" &&
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          )
        ) &&
        request.resource.data.reviewedBy == request.auth.uid;
    }

    function validDispatcherInvitationAccept(userId) {
      return isOwner(userId) &&
        resource.data.role == "dispatcher" &&
        resource.data.invitationStatus == "pending" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.dispatcherId == resource.data.dispatcherId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "invitationStatus",
            "updatedAt"
          ]) &&
        request.resource.data.invitationStatus == "accepted";
    }

    function isTechnicianProfile() {
      return resource.data.role == "technician";
    }

    function canGetUserProfile(userId) {
      return isOwner(userId) ||
        isSuperAdmin() ||
        (
          isActiveDispatcher() &&
          isTechnicianProfile()
        );
    }

    function canListUserProfiles() {
      return isSuperAdmin() ||
        (
          isActiveDispatcher() &&
          isTechnicianProfile()
        );
    }

    function isCustomer() {
      return signedIn() &&
        userRole(request.auth.uid) == "customer";
    }

    function isActiveCustomer() {
      return isCustomer() &&
        userHasActiveAccount(request.auth.uid);
    }

    function isActiveTechnician() {
      return signedIn() &&
        userRole(request.auth.uid) == "technician" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isVerifiedCustomer() {
      return isActiveCustomer() &&
        request.auth.token.email_verified == true;
    }

    function hasRequiredRequestCreateFields() {
      return request.resource.data.keys().hasAll([
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "technicianId",
        "technicianName",
        "serviceCategory",
        "title",
        "description",
        "address",
        "serviceArea",
        "division",
        "preferredDate",
        "preferredTime",
        "scheduledAt", "scheduledEndAt", "durationMinutes", "schedulingVersion", "bookingTimeZone", "scheduleRevision",
        "priority",
        "status",
        "imageUrls",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyCustomerRequestCreateFields() {
      return request.resource.data.keys().hasOnly([
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "technicianId",
        "technicianName",
        "serviceCategory",
        "title",
        "description",
        "address",
        "serviceArea",
        "division",
        "preferredDate",
        "preferredTime",
        "scheduledAt", "scheduledEndAt", "durationMinutes", "schedulingVersion", "bookingTimeZone", "scheduleRevision",
        "priority",
        "status",
        "imageUrls",
        "createdAt",
        "updatedAt"
      ]);
    }

    function isApprovedTechnicianId(technicianId) {
      let profile = get(/databases/$(database)/documents/users/$(technicianId)).data;
      return exists(/databases/$(database)/documents/users/$(technicianId)) &&
        profile.role == "technician" && profile.technicianApprovalStatus == "approved" && profileHasActiveAccount(profile);
    }

    function validSystemMessageAuditCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetType",
          "messageId",
          "metadata",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetType",
          "messageId",
          "metadata",
          "createdAt"
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == userRole(request.auth.uid) &&
        (
          (
            isActiveSuperAdmin() &&
            request.resource.data.actorRole == "super_admin" &&
            request.resource.data.action == "SUPER_ADMIN_SENT_SYSTEM_MESSAGE"
          ) ||
          (
            isActiveDispatcher() &&
            request.resource.data.actorRole == "dispatcher" &&
            request.resource.data.action == "DISPATCHER_SENT_SYSTEM_MESSAGE"
          )
        ) &&
        request.resource.data.targetType == "system_message" &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        request.resource.data.messageId == request.resource.data.targetUid &&
        request.resource.data.metadata.keys().hasOnly([
          "messageId",
          "audienceRoles",
          "priority"
        ]) &&
        request.resource.data.metadata.messageId ==
          request.resource.data.messageId &&
        request.resource.data.metadata.audienceRoles is list &&
        request.resource.data.metadata.audienceRoles.size() > 0 &&
        request.resource.data.metadata.priority in [
          "normal",
          "important",
          "critical"
        ] &&
        request.resource.data.createdAt is timestamp &&
        (
          (
            request.resource.data.actorRole == "super_admin" &&
            request.resource.data.metadata.audienceRoles.hasOnly([
              "customer",
              "technician",
              "dispatcher"
            ])
          ) ||
          (
            request.resource.data.actorRole == "dispatcher" &&
            request.resource.data.metadata.audienceRoles.hasOnly([
              "technician",
              "super_admin"
            ])
          )
        );
    }

    function technicianAcceptsNewRequests(technicianId) {
      // Check authoritative state at commit, including writes in the same batch.
      let profile = getAfter(/databases/$(database)/documents/users/$(technicianId)).data;
      let projection = getAfter(/databases/$(database)/documents/technician_map_profiles/$(technicianId)).data;
      return profile.role == "technician" && profile.technicianApprovalStatus == "approved" &&
        profileHasActiveAccount(profile) && profile.get("lifecyclePending", false) == false &&
        profile.get("emailVerified", false) == true && profile.get("availability", "") == "available" &&
        projection.approved == true && projection.get("availability", "") == "available";
    }

    function bookingCustomerEligible(customerId) {
      let profile = getAfter(/databases/$(database)/documents/users/$(customerId)).data;
      return profile.role == "customer" && profileHasActiveAccount(profile) &&
        profile.get("lifecyclePending", false) == false && profile.get("emailVerified", false) == true;
    }

    function validBookingAttempt(requestId) {
      let receipt = getAfter(/databases/$(database)/documents/booking_attempts/$(request.auth.uid)/requests/$(requestId)).data;
      return requestId.matches('^[A-Za-z0-9]{20}$') && receipt.requestId == requestId &&
        receipt.customerId == request.auth.uid && receipt.createdAt == request.time;
    }

    function validCustomerRequestCreate(requestId) {
      let customer = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isVerifiedCustomer() &&
        hasRequiredRequestCreateFields() &&
        hasOnlyCustomerRequestCreateFields() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerName is string && request.resource.data.customerEmail is string && request.resource.data.customerPhone is string &&
        request.resource.data.customerName == customer.fullName &&
        request.resource.data.customerEmail == customer.email && request.resource.data.customerPhone == customer.phone &&
        request.resource.data.technicianId is string &&
        request.resource.data.technicianName is string &&
        request.resource.data.technicianName == getAfter(/databases/$(database)/documents/technician_map_profiles/$(request.resource.data.technicianId)).data.fullName &&
        isApprovedTechnicianId(request.resource.data.technicianId) &&
        technicianAcceptsNewRequests(request.resource.data.technicianId) &&
        request.resource.data.status == "requested" &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && validBookingAttempt(requestId) &&
        request.resource.data.schedulingVersion == 1 && request.resource.data.bookingTimeZone == "Asia/Colombo" && request.resource.data.scheduleRevision == 0 &&
        request.resource.data.durationMinutes is int && request.resource.data.durationMinutes > 0 &&
        request.resource.data.scheduledEndAt is timestamp &&
        request.resource.data.scheduledEndAt == request.resource.data.scheduledAt + duration.value(request.resource.data.durationMinutes, "m") &&
        request.resource.data.scheduledAt is timestamp &&
        request.resource.data.scheduledAt > request.time &&
        request.resource.data.priority in ["normal", "urgent"] &&
        validRequestAttachments(requestId) && bookingNotice(requestId, 'new_customer_request', request.resource.data.technicianId);
    }

    function validRequestAttachments(requestId) {
      let paths = request.resource.data.imageUrls;
      return paths is list && paths.size() <= 2 && paths.toSet().size() == paths.size() &&
        (paths.size() < 1 || confirmedR2Photo(paths[0], requestId, request.auth.uid, 'request')) &&
        (paths.size() < 2 || confirmedR2Photo(paths[1], requestId, request.auth.uid, 'request'));
    }
    function confirmedR2Photo(ref, requestId, ownerId, purpose) {
      return ref is string && ref.matches('^r2:v1:[a-f0-9]{64}$') && validR2Record(ref.split(':')[2], requestId, ownerId, purpose);
    }
    function validR2Record(id, requestId, ownerId, purpose) {
      let photo = get(/databases/$(database)/documents/photo_objects/$(id)).data;
      return photo.provider == 'r2' && photo.id == id && photo.state == 'confirmed' &&
        photo.ownerId == ownerId && photo.requestId == requestId && photo.purpose == purpose &&
        photo.expiresAt is timestamp && photo.expiresAt > request.time &&
        photo.size is int && photo.size > 0 &&
        (purpose == 'request' ? photo.size < 2000000 && photo.contentType in ['image/jpeg', 'image/png', 'image/webp'] :
          photo.size <= 5 * 1024 * 1024 && photo.contentType == 'image/jpeg');
    }

    function validCustomerRequestCancel(requestId) {
      return isVerifiedCustomer() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.status in ["requested", "pending"] &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancelledBy == "customer" &&
        request.resource.data.cancelledAt == request.time && request.resource.data.updatedAt == request.time &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "updatedAt",
            "cancelledAt",
            "cancelledBy"
          ]) && bookingNotice(requestId, 'customer_cancelled_request', resource.data.get('technicianId', resource.data.get('assignedTechnicianId', '')));
    }

    function validJobPhoto(path, jobId, technicianId, stage) {
      // Existing Firebase/R2 references may be retained. New references must be
      // independently confirmed by the trusted Worker; clients cannot mint a
      // nonexistent legacy Firebase path to bypass completion requirements.
      return (request.method == 'update' && path in resource.data.get(stage == 'before' ? 'beforePhotos' : 'afterPhotos', [])) ||
        confirmedR2Photo(path, jobId, technicianId, stage);
    }
    function validJobPhotos(paths, jobId, technicianId, stage) {
      return paths is list && paths.size() <= 3 && paths.toSet().size() == paths.size() &&
        (paths.size() < 1 || validJobPhoto(paths[0], jobId, technicianId, stage)) &&
        (paths.size() < 2 || validJobPhoto(paths[1], jobId, technicianId, stage)) &&
        (paths.size() < 3 || validJobPhoto(paths[2], jobId, technicianId, stage));
    }
    function validEvidencePart(parts, index) {
      return parts.size() <= index ? true : validEvidencePartRecord(parts[index]);
    }
    function validEvidencePartRecord(part) {
      let name = part.name;
      let quantity = part.quantity;
      // keys() requires a map and trim() requires a string; other types fail
      // closed, without redundant type expressions for every one of ten parts.
      return part.keys().hasOnly(['name', 'quantity']) &&
        name.trim().size() > 0 && name.size() <= 100 &&
        quantity is int && quantity > 0 && quantity <= 999;
    }
    function validEvidenceNotes(notes) {
      return notes is map && notes.keys().hasOnly(['diagnosis', 'workCompleted', 'recommendation', 'parts']) &&
        notes.diagnosis is string && notes.diagnosis.trim().size() >= 10 && notes.diagnosis.size() <= 3000 &&
        notes.workCompleted is string && notes.workCompleted.trim().size() >= 10 && notes.workCompleted.size() <= 3000 &&
        notes.recommendation is string && notes.recommendation.size() <= 3000 && validEvidenceParts(notes.parts);
    }
    function validEvidenceParts(parts) {
      return parts is list && parts.size() <= 10 &&
        validEvidencePart(parts, 0) && validEvidencePart(parts, 1) && validEvidencePart(parts, 2) &&
        validEvidencePart(parts, 3) && validEvidencePart(parts, 4) && validEvidencePart(parts, 5) &&
        validEvidencePart(parts, 6) && validEvidencePart(parts, 7) && validEvidencePart(parts, 8) && validEvidencePart(parts, 9);
    }
    function validEvidenceSignature(signature) {
      return signature is map && signature.keys().hasOnly(['customerName', 'path', 'confirmed', 'signedAt']) &&
        signature.customerName is string && signature.customerName.trim().size() > 0 && signature.customerName.size() <= 100 &&
        signature.confirmed == true && signature.signedAt is timestamp && signature.path is string &&
        signature.path.size() >= 20 && signature.path.size() <= 15000 && signature.path.matches('^M[0-9., ML]+$') && signature.path.matches('.*L.*');
    }
    function completeEvidence(jobId, job) {
      let evidence = get(/databases/$(database)/documents/job_evidence/$(jobId)).data;
      // Evidence is fully validated at its own write boundary. Rechecking every
      // part/photo here would exceed the Rules expression budget for completion.
      return evidence.requestId == jobId && evidence.customerId == job.customerId && requestTechnicianMatches(job, evidence.technicianId) &&
        evidence.beforePhotos.size() > 0 && evidence.afterPhotos.size() > 0 &&
        evidence.notes.diagnosis.trim().size() > 0 && evidence.notes.workCompleted.trim().size() > 0 &&
        evidence.signature.confirmed == true && evidence.signature.path.size() >= 20;
    }
    function validJobEvidence(jobId) {
      let data = request.resource.data;
      let job = get(/databases/$(database)/documents/service_requests/$(jobId)).data;
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      // The enclosing match already enforces hasActiveSession (including active
      // profile, lifecycle and revocation). Do not repeat it per validated part.
      return request.auth.token.email_verified == true && author.role == 'technician' &&
        author.technicianApprovalStatus == 'approved' && requestTechnicianMatches(job, request.auth.uid) &&
        data.keys().hasOnly(['requestId', 'technicianId', 'customerId', 'revision', 'beforePhotos', 'afterPhotos', 'notes', 'notesUpdatedAt', 'signature', 'updatedAt']) &&
        data.requestId == jobId && data.technicianId == request.auth.uid && data.customerId == job.customerId &&
        data.updatedAt == request.time && data.revision is int && data.revision == (request.method == 'create' ? 1 : resource.data.revision + 1) &&
        (request.method == 'update' && data.beforePhotos == resource.data.beforePhotos ? true : validJobPhotos(data.beforePhotos, jobId, request.auth.uid, 'before')) &&
        (request.method == 'update' && data.afterPhotos == resource.data.afterPhotos ? true : validJobPhotos(data.afterPhotos, jobId, request.auth.uid, 'after')) &&
        (!data.keys().hasAny(['notes']) ? !data.keys().hasAny(['notesUpdatedAt']) :
          (request.method == 'update' && data.notes == resource.data.get('notes', null) ?
            data.get('notesUpdatedAt', null) == resource.data.get('notesUpdatedAt', null) :
            data.notesUpdatedAt == request.time && validEvidenceNotes(data.notes))) &&
        (!data.keys().hasAny(['signature']) ||
          (request.method == 'update' && data.signature == resource.data.get('signature', null) ? true :
            validEvidenceSignature(data.signature) && data.signature.signedAt == request.time)) &&
        (job.status == 'in_progress' || (job.status in ['accepted', 'assigned'] &&
          data.afterPhotos.size() == 0 && !data.keys().hasAny(['notes', 'signature']))) &&
        (request.method == 'create' || data.diff(resource.data).affectedKeys().hasOnly(['beforePhotos', 'afterPhotos', 'notes', 'notesUpdatedAt', 'signature', 'revision', 'updatedAt']));
    }
    function freshWorkTimer(data) {
      let timer = data.workTimer;
      return timer.keys().hasOnly(['elapsedMs', 'runningSince', 'pausedAt', 'revision']) &&
        timer.elapsedMs == 0 && timer.runningSince == request.time && timer.pausedAt == null && timer.revision == 0;
    }
    function pausedWorkTimer(before, after) {
      let timer = after.workTimer;
      let previous = before.get('workTimer', null);
      return timer.keys().hasOnly(['elapsedMs', 'runningSince', 'pausedAt', 'revision']) &&
        timer.elapsedMs == (previous == null ? 0 : previous.elapsedMs) &&
        timer.runningSince == (previous == null ? before.startedAt : previous.runningSince) &&
        timer.pausedAt == request.time && timer.pausedAt >= timer.runningSince &&
        timer.revision == (previous == null ? 1 : previous.revision + 1) &&
        (previous == null || previous.pausedAt == null);
    }
    function finalizedWorkTimer(before, after) {
      return !before.keys().hasAny(['workTimer']) ? !after.keys().hasAny(['workTimer']) :
        (before.workTimer.pausedAt != null ? after.workTimer == before.workTimer : pausedWorkTimer(before, after));
    }
    function validWorkTimerUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let previous = before.get('workTimer', null);
      let timer = after.workTimer;
      return isVerifiedApprovedTechnician() && requestTechnicianMatches(before, request.auth.uid) &&
        before.status == 'in_progress' && after.updatedAt == request.time &&
        after.diff(before).affectedKeys().hasOnly(['workTimer', 'updatedAt']) &&
        (pausedWorkTimer(before, after) ||
          (previous != null && previous.pausedAt != null &&
            timer.keys().hasOnly(['elapsedMs', 'runningSince', 'pausedAt', 'revision']) &&
            timer.elapsedMs == previous.elapsedMs + previous.pausedAt.toMillis() - previous.runningSince.toMillis() &&
            timer.elapsedMs >= 0 && timer.runningSince == request.time && timer.pausedAt == null && timer.revision == previous.revision + 1));
    }
    function validTechnicianRequestStatusUpdate(requestId) {
      let notificationType = request.resource.data.status == 'accepted' ? 'technician_accepted_request' :
        request.resource.data.status == 'rejected' ? 'technician_rejected_request' :
        request.resource.data.status == 'in_progress' ? 'job_started' :
        request.resource.data.status == 'completed' ? 'job_completed' : 'technician_cancelled_job';
      return isVerifiedApprovedTechnician() &&
        requestTechnicianMatches(resource.data, request.auth.uid) &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "acceptedAt",
            "rejectedAt",
            "startedAt",
            "completedAt",
            "technicianCancelledAt",
            "cancelledBy",
            "rejectionReason",
            "technicianCancellationReason",
            "workTimer",
            "updatedAt"
          ]) &&
        (
          (
            false // Acceptance/reservation is authorized by the trusted scheduling endpoint.
          ) ||
          (
            resource.data.status in ["requested", "pending"] &&
            request.resource.data.status == "rejected" &&
            request.resource.data.rejectedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "rejectedAt", "rejectionReason", "updatedAt"]) &&
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          ) ||
          (
            resource.data.status in ["accepted", "assigned"] &&
            request.resource.data.status == "in_progress" && request.resource.data.startedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "startedAt", "workTimer", "updatedAt"]) &&
            (!request.resource.data.keys().hasAny(['workTimer']) || freshWorkTimer(request.resource.data))
          ) ||
          (
            resource.data.status in ["accepted", "assigned"] &&
            request.resource.data.status == "cancelled" &&
            request.resource.data.technicianCancelledAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "technicianCancelledAt", "cancelledBy", "technicianCancellationReason", "workTimer", "updatedAt"]) &&
            finalizedWorkTimer(resource.data, request.resource.data) &&
            request.resource.data.cancelledBy == "technician" &&
            request.resource.data.technicianCancellationReason is string &&
            request.resource.data.technicianCancellationReason.size() > 0
          ) ||
          (
            resource.data.status == "in_progress" &&
            request.resource.data.status == "completed" && request.resource.data.completedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "completedAt", "workTimer", "updatedAt"]) &&
            finalizedWorkTimer(resource.data, request.resource.data) &&
            completeEvidence(requestId, resource.data)
          )
        ) && bookingNotice(requestId, notificationType, resource.data.customerId);
    }

    function validNotificationReadUpdate() {
      return signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["read", "updatedAt"]) &&
        request.resource.data.read == true;
    }

    function validNotificationBaseCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "userId",
          "type",
          "title",
          "message",
          "requestId",
          "priority",
          "read",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "type",
          "title",
          "message",
          "requestId",
          "priority",
          "read",
          "createdAt"
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.requestId is string &&
        request.resource.data.requestId.size() > 0 &&
        request.resource.data.priority in [
          "normal",
          "important",
          "critical"
        ] &&
        request.resource.data.read == false &&
        request.resource.data.createdAt is timestamp &&
        notificationRequest().customerId is string;
    }

    function notificationRequest() {
      return getAfter(
        /databases/$(database)/documents/service_requests/$(request.resource.data.requestId)
      ).data;
    }

    function serviceRequestData(requestId) {
      return get(
        /databases/$(database)/documents/service_requests/$(requestId)
      ).data;
    }

    function requestTechnicianMatches(data, technicianId) {
      let current = data.get('technicianId', null);
      let legacy = data.get('assignedTechnicianId', null);
      let hasCurrent = current is string && current.size() > 0;
      let hasLegacy = legacy is string && legacy.size() > 0;
      return !(hasCurrent && hasLegacy && current != legacy) &&
        ((hasCurrent && current == technicianId) || (!hasCurrent && hasLegacy && legacy == technicianId));
    }

    function bookingNotice(requestId, type, userId) {
      let notification = getAfter(/databases/$(database)/documents/notifications/$(requestId + '_' + type)).data;
      return notification.requestId == requestId && notification.type == type && notification.userId == userId && notification.createdAt == request.time;
    }
    function validRequestNotificationCreate(notificationId) {
      return validNotificationBaseCreate() &&
        (request.resource.data.type == 'new_review' || (notificationId == request.resource.data.requestId + '_' + request.resource.data.type &&
          request.resource.data.createdAt == request.time && notificationRequest().updatedAt == request.time)) &&
        (
          (
            request.resource.data.type == "new_customer_request" &&
            notificationRequest().customerId == request.auth.uid &&
            notificationRequest().technicianId == request.resource.data.userId
          ) ||
          (
            request.resource.data.type == "customer_cancelled_request" &&
            notificationRequest().customerId == request.auth.uid &&
            requestTechnicianMatches(notificationRequest(), request.resource.data.userId) &&
            notificationRequest().status == "cancelled"
          ) ||
          (
            request.resource.data.type in [
              "technician_accepted_request",
              "technician_rejected_request",
              "job_started",
              "technician_cancelled_job",
              "job_completed"
            ] &&
            requestTechnicianMatches(notificationRequest(), request.auth.uid) &&
            notificationRequest().customerId == request.resource.data.userId &&
            (
              (
                request.resource.data.type == "technician_accepted_request" &&
                notificationRequest().status == "accepted"
              ) ||
              (
                request.resource.data.type == "technician_rejected_request" &&
                notificationRequest().status == "rejected"
              ) ||
              (
                request.resource.data.type == "job_started" &&
                notificationRequest().status == "in_progress"
              ) ||
              (
                request.resource.data.type == "technician_cancelled_job" &&
                notificationRequest().status == "cancelled" &&
                notificationRequest().cancelledBy == "technician"
              ) ||
              (
                request.resource.data.type == "job_completed" &&
                notificationRequest().status == "completed"
              )
            )
          ) ||
          (
            request.resource.data.type == "new_review" &&
            notificationRequest().customerId == request.auth.uid &&
            requestTechnicianMatches(
              notificationRequest(),
              request.resource.data.userId
            ) &&
            exists(
              /databases/$(database)/documents/service_reviews/$(request.resource.data.requestId + "_" + request.auth.uid)
            )
          )
        );
    }

    function isOwnCompletedRequest(requestId) {
      return exists(
        /databases/$(database)/documents/service_requests/$(requestId)
      ) &&
        serviceRequestData(requestId).customerId == request.auth.uid &&
        serviceRequestData(requestId).status == "completed";
    }

    function validReviewPhotoAt(data, reviewId, index) {
      return data.photoPaths.size() <= index ||
        data.photoPaths[index] == "review_photos/" + request.auth.uid + "/" + reviewId + "/" + data.photoAttemptId + "/" + string(index) + ".jpg";
    }

    function validReviewPhotos(data, reviewId) {
      return (!data.keys().hasAny(["photoPaths", "photoAttemptId"])) ||
        (data.keys().hasAll(["photoPaths", "photoAttemptId"]) &&
          data.photoPaths is list && data.photoPaths.size() > 0 && data.photoPaths.size() <= 5 &&
          data.photoAttemptId is string && data.photoAttemptId.matches("^[A-Za-z0-9]{20}$") &&
          validReviewPhotoAt(data, reviewId, 0) && validReviewPhotoAt(data, reviewId, 1) &&
          validReviewPhotoAt(data, reviewId, 2) && validReviewPhotoAt(data, reviewId, 3) && validReviewPhotoAt(data, reviewId, 4));
    }

    function validReviewCreate(reviewId) {
      return isVerifiedCustomer() &&
        request.resource.data.keys().hasOnly([
          "requestId",
          "customerId",
          "technicianId",
          "customerName",
          "rating",
          "comment",
          "photoPaths",
          "photoAttemptId",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "requestId",
          "customerId",
          "technicianId",
          "customerName",
          "rating",
          "comment",
          "createdAt"
        ]) &&
        (
          request.resource.data.customerName is string &&
          request.resource.data.customerName.size() > 0 &&
          request.resource.data.customerName.size() <= 80 &&
          !request.resource.data.customerName.matches("(?i)\\s*customer\\s*") &&
          request.resource.data.customerName.matches(".*\\S.*") &&
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.fullName is string &&
          request.resource.data.customerName ==
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.fullName
        ) &&
        request.resource.data.customerId == request.auth.uid &&
        reviewId ==
          request.resource.data.requestId + "_" + request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 300 &&
        request.resource.data.createdAt == request.time &&
        validReviewPhotos(request.resource.data, reviewId) &&
        request.resource.data.technicianId is string &&
        request.resource.data.technicianId.size() > 0 &&
        isApprovedTechnicianId(request.resource.data.technicianId) &&
        isOwnCompletedRequest(request.resource.data.requestId) &&
        requestTechnicianMatches(
          serviceRequestData(request.resource.data.requestId),
          request.resource.data.technicianId
        );
    }

    function isVerifiedApprovedTechnician() {
      // isApprovedTechnicianId already checks role and active account. Avoid
      // repeating those expressions for each evidence transaction read/write.
      return signedIn() &&
        request.auth.token.email_verified == true &&
        isApprovedTechnicianId(request.auth.uid);
    }

    function canReadServiceReview() {
      return signedIn() &&
        (
          isSuperAdmin() ||
          resource.data.customerId == request.auth.uid ||
          (
            isVerifiedApprovedTechnician() &&
            resource.data.technicianId == request.auth.uid
          ) ||
          (
            isVerifiedCustomer() &&
            isApprovedTechnicianId(resource.data.technicianId)
          )
        );
    }

    function validSystemMessageFields() {
      return request.resource.data.keys().hasOnly([
        "senderId",
        "senderName",
        "senderRole",
        "audienceRoles",
        "title",
        "message",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "senderId",
        "senderName",
        "senderRole",
        "audienceRoles",
        "title",
        "message",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.senderId == request.auth.uid &&
      request.resource.data.senderRole == userRole(request.auth.uid) &&
      request.resource.data.senderName ==
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.fullName &&
      request.resource.data.audienceRoles is list &&
      request.resource.data.audienceRoles.size() > 0 &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.message is string &&
      request.resource.data.message.size() > 0 &&
      request.resource.data.priority in [
        "normal",
        "important",
        "critical"
      ] &&
      request.resource.data.status in [
        "active",
        "sent"
      ] &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp;
    }

    function validSystemMessageCreate() {
      return validSystemMessageFields() &&
        (
          (
            isActiveSuperAdmin() &&
            request.resource.data.audienceRoles.hasOnly([
              "customer",
              "technician",
              "dispatcher"
            ])
          ) ||
          (
            isActiveDispatcher() &&
            request.resource.data.audienceRoles.hasOnly([
              "technician",
              "super_admin"
            ])
          )
        );
    }

    function isPublishedSystemMessage(data) {
      return data.status == "active" ||
        data.status == "sent";
    }

    function isCustomerSystemMessageRecipient(data) {
      return isActiveCustomer() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["customer"]);
    }

    function isTechnicianSystemMessageRecipient(data) {
      return isActiveTechnician() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["technician"]);
    }

    function isDispatcherSystemMessageRecipient(data) {
      return isActiveDispatcher() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["dispatcher"]);
    }

    function isSuperAdminSystemMessageRecipient(data) {
      return isActiveSuperAdmin() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["super_admin"]);
    }

    function canReadSystemMessageAsRecipient(data) {
      return signedIn() &&
        (
          isCustomerSystemMessageRecipient(data) ||
          isTechnicianSystemMessageRecipient(data) ||
          isDispatcherSystemMessageRecipient(data) ||
          isSuperAdminSystemMessageRecipient(data)
        );
    }

    function canReadOwnDispatcherSystemMessage(data) {
      return isActiveDispatcher() &&
        isPublishedSystemMessage(data) &&
        data.senderId == request.auth.uid &&
        data.senderRole == "dispatcher";
    }

    function canReadSystemMessage() {
      return isActiveSuperAdmin() ||
        canReadSystemMessageAsRecipient(resource.data) ||
        canReadOwnDispatcherSystemMessage(resource.data);
    }

    function canReadReferencedSystemMessage(messageId) {
      let message = get(/databases/$(database)/documents/system_messages/$(messageId)).data;
      // A missing message still fails closed. Avoid duplicate exists/get calls
      // for every receipt in an all-history batch; recipient policy is unchanged.
      return signedIn() && canReadSystemMessageAsRecipient(message);
    }

    function validMessageReadWrite(readId) {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "userId",
          "messageId",
          "readAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "messageId",
          "readAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        readId == request.auth.uid + "_" + request.resource.data.messageId &&
        request.resource.data.messageId is string &&
        request.resource.data.messageId.size() > 0 &&
        request.resource.data.readAt is timestamp &&
        canReadReferencedSystemMessage(request.resource.data.messageId);
    }

    function validServiceDistrictIds(ids) {
      return ids is list && ids.size() <= 25 && ids.toSet().size() == ids.size() && ids.hasOnly([
        "ampara", "anuradhapura", "badulla", "batticaloa", "colombo", "galle", "gampaha",
        "hambantota", "jaffna", "kalutara", "kandy", "kegalle", "kilinochchi", "kurunegala",
        "mannar", "matale", "matara", "monaragala", "mullaitivu", "nuwara-eliya",
        "polonnaruwa", "puttalam", "ratnapura", "trincomalee", "vavuniya"
      ]);
    }

    function ownsTechnicianLocation(technicianId) {
      return isOwner(technicianId) && userRole(technicianId) == "technician";
    }

    function validDistrictArea(areas, districtId) {
      let area = areas.get(districtId, "");
      return !(districtId in areas) ||
        (area is string && area.matches('other:[^ <>\\x00-\\x1f\\x7f][^<>\\x00-\\x1f\\x7f]{0,78}[^ <>\\x00-\\x1f\\x7f]')) ||
        (districtId == "kandy" && area in [
          "lk-postal-20400-peradeniya", "lk-postal-20800-katugastota", "lk-postal-20168-kundasale", "lk-postal-20500-gampola"]);
    }

    function validServiceAreas(areas, ids) {
      return areas is map && validServiceDistrictIds(ids) && areas.keys().hasOnly(ids) &&
        validDistrictArea(areas, "ampara") && validDistrictArea(areas, "anuradhapura") &&
        validDistrictArea(areas, "badulla") && validDistrictArea(areas, "batticaloa") &&
        validDistrictArea(areas, "colombo") && validDistrictArea(areas, "galle") &&
        validDistrictArea(areas, "gampaha") && validDistrictArea(areas, "hambantota") &&
        validDistrictArea(areas, "jaffna") && validDistrictArea(areas, "kalutara") &&
        validDistrictArea(areas, "kandy") && validDistrictArea(areas, "kegalle") &&
        validDistrictArea(areas, "kilinochchi") && validDistrictArea(areas, "kurunegala") &&
        validDistrictArea(areas, "mannar") && validDistrictArea(areas, "matale") &&
        validDistrictArea(areas, "matara") && validDistrictArea(areas, "monaragala") &&
        validDistrictArea(areas, "mullaitivu") && validDistrictArea(areas, "nuwara-eliya") &&
        validDistrictArea(areas, "polonnaruwa") && validDistrictArea(areas, "puttalam") &&
        validDistrictArea(areas, "ratnapura") && validDistrictArea(areas, "trincomalee") &&
        validDistrictArea(areas, "vavuniya");
    }

    // BEGIN GENERATED SERVICE CATEGORIES (scripts/generate-service-category-rules.mjs)
    function validServiceCategoryId(id) {
      return id in ["electrical","plumbing","air-conditioning","appliance-repair","it-computer-support","general-maintenance","other"];
    }
    function serviceCategoryLabel(id) {
      return id == "electrical" ? "Electrical" :
        id == "plumbing" ? "Plumbing" :
        id == "air-conditioning" ? "Air Conditioning" :
        id == "appliance-repair" ? "Appliance Repair" :
        id == "it-computer-support" ? "IT / Computer Support" :
        id == "general-maintenance" ? "General Maintenance" :
        id == "other" ? "Other" : "";
    }
    function serviceCategoryIdForValue(value) {
      let label = value is string ? value.lower() : "";
      return label.matches("\\s*(electrical|electrician|electrical\\s+installation)\\s*") ? "electrical" :
        label.matches("\\s*(plumbing|plumber|plumbing\\s+services)\\s*") ? "plumbing" :
        label.matches("\\s*(air-conditioning|air\\s+conditioning|ac|a/c|ac\\s+technician|ac\\s+repair|ac\\s+services)\\s*") ? "air-conditioning" :
        label.matches("\\s*(appliance-repair|appliance\\s+repair|washing\\s+machine\\s+repair|tv\\s+repair|refrigerator\\s+repair)\\s*") ? "appliance-repair" :
        label.matches("\\s*(it-computer-support|it\\s+/\\s+computer\\s+support|computer\\s+repair|it\\s+support)\\s*") ? "it-computer-support" :
        label.matches("\\s*(general-maintenance|general\\s+maintenance)\\s*") ? "general-maintenance" :
        label.matches("\\s*(other)\\s*") ? "other" : "";
    }
    function technicianCategoryId(profile) {
      let id = profile.get("serviceCategoryId", "");
      let raw = profile.get("specialization", "");
      let explicit = serviceCategoryIdForValue(profile.get("serviceCategory", ""));
      let legacy = serviceCategoryIdForValue(raw);
      let legacyPresent = raw is string ? !raw.matches("\\s*") : true;
      return id != "" ? (validServiceCategoryId(id) ? id : "") :
        (legacyPresent && legacy == "" || explicit != "" && legacy != "" && explicit != legacy) ? "" :
        explicit != "" ? explicit : legacy;
    }
    function validSelectedTechnicianCategory(profile) {
      let id = profile.get("serviceCategoryId", "");
      return validServiceCategoryId(id) && profile.specialization == serviceCategoryLabel(id);
    }
    function mapCategory(profile) { return serviceCategoryLabel(technicianCategoryId(profile)); }
    // END GENERATED SERVICE CATEGORIES

    function validMapProfile(technicianId) {
      let data = request.resource.data;
      let profile = getAfter(/databases/$(database)/documents/users/$(technicianId)).data;
      return (ownsTechnicianLocation(technicianId) && userHasActiveAccount(technicianId) && request.auth.token.email_verified == true ||
          isActiveDispatcher() || isSuperAdmin()) &&
        profile.role == "technician" &&
        data.keys().hasAll(["technicianId", "fullName", "specialization", "serviceCategory", "serviceDistrictIds", "approved", "averageRating", "reviewCount", "updatedAt"]) &&
        data.keys().hasOnly(["technicianId", "fullName", "specialization", "serviceCategory", "serviceCategoryId", "serviceDistrictIds", "serviceAreasByDistrict", "publicDetails", "availability", "approved", "averageRating", "reviewCount", "updatedAt"]) &&
        data.get("availability", null) == (profile.get("availability", null) in ["available", "busy", "offline"] ? profile.availability : null) &&
        data.technicianId == technicianId && data.fullName is string && data.fullName.size() > 0 && data.fullName == profile.fullName &&
        data.specialization is string && data.specialization == profile.get("specialization", "") &&
        data.get("serviceCategoryId", technicianCategoryId(profile)) == technicianCategoryId(profile) &&
        (data.serviceCategory == mapCategory(profile) || !data.keys().hasAny(["serviceCategoryId"]) && data.serviceCategory == "") &&
        validServiceDistrictIds(data.serviceDistrictIds) &&
        data.serviceDistrictIds == profile.get("serviceDistrictIds", []) &&
        data.get("serviceAreasByDistrict", {}) == profile.get("serviceAreasByDistrict", {}) &&
        (!data.keys().hasAny(["publicDetails"]) || data.publicDetails == {
          "experience": profile.get("experience", ""), "qualifications": profile.get("qualifications", ""),
          "certifications": profile.get("certifications", ""), "profilePhotoUrl": profile.get("profilePhotoUrl", ""),
          "completedJobs": profile.get("completedJobs", 0)
        }) &&
        data.approved is bool && data.approved == (profile.technicianApprovalStatus == "approved" && profileHasActiveAccount(profile)) &&
        data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5 && data.averageRating == profile.get("averageRating", 0) &&
        data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount == profile.get("reviewCount", 0) && data.updatedAt == request.time;
    }

    match /technician_map_profiles/{technicianId} {
      allow get: if hasActiveSession() && (ownsTechnicianLocation(technicianId) || isSuperAdmin() || isActiveDispatcher() ||
        (isVerifiedCustomer() && resource.data.approved == true && isApprovedTechnicianId(technicianId)));
      // Query snapshot approval; validate current approval with the get above before display.
      // No private profile or coordinates are exposed through this display-only query.
      allow list: if hasActiveSession() && isVerifiedCustomer() && request.query.limit != null && request.query.limit <= 24 &&
        resource.data.approved == true;
      allow create, update: if hasActiveSession() && validMapProfile(technicianId);
      allow delete: if false;
    }

    function eligibleLocationRequest(requestId, technicianId, customerId) {
      let job = get(/databases/$(database)/documents/service_requests/$(requestId)).data;
      return job.customerId == customerId && job.status in ["accepted", "assigned", "in_progress"] &&
        requestTechnicianMatches(job, technicianId);
    }

    match /technician_location_access/{technicianId}/customers/{customerId} {
      // A Customer may provide their own job reference, never an arbitrary grant.
      allow get: if hasActiveSession() && isOwner(customerId) && isVerifiedCustomer();
      allow list, delete: if false;
      allow create, update: if hasActiveSession() && isOwner(customerId) && isVerifiedCustomer() &&
        request.resource.data.keys().hasAll(["requestId", "technicianId", "customerId", "updatedAt"]) &&
        request.resource.data.keys().hasOnly(["requestId", "technicianId", "customerId", "updatedAt"]) &&
        request.resource.data.customerId == customerId && request.resource.data.technicianId == technicianId &&
        request.resource.data.requestId is string && request.resource.data.requestId.size() > 0 &&
        request.resource.data.updatedAt == request.time && isApprovedTechnicianId(technicianId) &&
        eligibleLocationRequest(request.resource.data.requestId, technicianId, customerId);
    }

    function canGetJobLocation(technicianId) {
      let proof = get(/databases/$(database)/documents/technician_location_access/$(technicianId)/customers/$(request.auth.uid)).data;
      return isVerifiedCustomer() && isApprovedTechnicianId(technicianId) &&
        resource.data.technicianId == technicianId && resource.data.sharingEnabled == true &&
        resource.data.updatedAt is timestamp && resource.data.updatedAt <= request.time + duration.value(5, 's') &&
        resource.data.updatedAt >= request.time - duration.value(120, 's') &&
        eligibleLocationRequest(proof.requestId, technicianId, request.auth.uid);
    }

    function validPrivateLocation(technicianId) {
      let data = request.resource.data;
      let publicData = getAfter(/databases/$(database)/documents/technician_map_locations/$(technicianId)).data;
      return ownsTechnicianLocation(technicianId) &&
        data.keys().hasAll(["technicianId", "sharingEnabled", "updatedAt"]) &&
        data.keys().hasOnly(["technicianId", "sharingEnabled", "updatedAt", "latitude", "longitude", "sampledAt"]) &&
        data.technicianId == technicianId && data.sharingEnabled is bool && data.updatedAt == request.time &&
        publicData.sharingEnabled == data.sharingEnabled && publicData.updatedAt == request.time &&
        (
          (data.sharingEnabled == false && !data.keys().hasAny(["latitude", "longitude", "sampledAt"])) ||
          (isVerifiedApprovedTechnician() && data.sharingEnabled == true &&
            data.sampledAt is timestamp &&
            data.sampledAt >= request.time - duration.value(60, 's') &&
            data.sampledAt <= request.time + duration.value(5, 's') &&
            data.latitude is number && data.longitude is number &&
            data.latitude >= -90 && data.latitude <= 90 && data.longitude >= -180 && data.longitude <= 180)
        );
    }

    function validApproximateLocation(technicianId) {
      let data = request.resource.data;
      let precise = getAfter(/databases/$(database)/documents/technician_locations/$(technicianId)).data;
      return ownsTechnicianLocation(technicianId) &&
        data.keys().hasAll(["technicianId", "sharingEnabled", "updatedAt"]) &&
        data.keys().hasOnly(["technicianId", "sharingEnabled", "updatedAt", "latCell", "lngCell"]) &&
        data.technicianId == technicianId && data.sharingEnabled is bool && data.updatedAt == request.time &&
        precise.sharingEnabled == data.sharingEnabled && precise.updatedAt == request.time &&
        (
          (data.sharingEnabled == false && !data.keys().hasAny(["latCell", "lngCell"])) ||
          (isVerifiedApprovedTechnician() && data.sharingEnabled == true &&
            data.latCell is int && data.lngCell is int &&
            data.latCell >= -9000 && data.latCell <= 9000 && data.lngCell >= -18000 && data.lngCell <= 18000 &&
            precise.latitude >= data.latCell / 100.0 && precise.latitude < (data.latCell + 1) / 100.0 &&
            precise.longitude >= data.lngCell / 100.0 && precise.longitude < (data.lngCell + 1) / 100.0)
        );
    }

    match /technician_locations/{technicianId} {
      // Single-document access rechecks the authoritative job on every server read.
      allow get: if hasActiveSession() && (ownsTechnicianLocation(technicianId) || canGetJobLocation(technicianId));
      allow list, delete: if false;
      allow create, update: if hasActiveSession() && validPrivateLocation(technicianId);
    }

    match /technician_map_locations/{technicianId} {
      // Only fixed approved Technician IDs from the safe map directory; no broad query.
      allow get: if hasActiveSession() && (ownsTechnicianLocation(technicianId) ||
        (isVerifiedCustomer() && isApprovedTechnicianId(technicianId)));
      allow list, delete: if false;
      allow create, update: if hasActiveSession() && validApproximateLocation(technicianId);
    }

    function mapApprovalFollowsUser(userId) {
      // Client approval updates must revoke the display snapshot atomically.
      let projection = /databases/$(database)/documents/technician_map_profiles/$(userId);
      return resource.data.role != "technician" ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["accountStatus", "technicianApprovalStatus"]) ||
        (getAfter(projection).data.technicianId == userId && getAfter(projection).data.updatedAt == request.time &&
          getAfter(projection).data.approved == (request.resource.data.technicianApprovalStatus == "approved" && profileHasActiveAccount(request.resource.data)));
    }

    match /users/{userId} {
      // Privileged Dispatcher profiles are created only by the trusted Admin SDK.
      allow create: if validPublicUserCreate(userId);
      allow get: if isOwner(userId) || (hasActiveSession() && canGetUserProfile(userId));
      allow list: if hasActiveSession() && canListUserProfiles();
      allow update: if hasActiveSession() && (validOwnerUpdate(userId) ||
        validTechnicianAvailabilityUpdate(userId) ||
        validDispatcherInvitationAccept(userId) ||
        validDispatcherTechnicianReview()) && mapApprovalFollowsUser(userId);
      allow delete: if false;
    }

    match /booking_attempts/{customerId}/requests/{requestId} {
      // First submissions read a missing receipt. Authorize this single get from
      // the authenticated path owner, never from nonexistent resource.data.
      allow get: if hasActiveSession() && isVerifiedCustomer() && request.auth.uid == customerId;
      allow list, update, delete: if false;
      allow create: if hasActiveSession() && isVerifiedCustomer() && request.auth.uid == customerId &&
        requestId.matches('^[A-Za-z0-9]{20}$') &&
        request.resource.data.keys().hasOnly(["requestId", "customerId", "createdAt"]) &&
        request.resource.data.requestId == requestId && request.resource.data.customerId == customerId &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.customerId == customerId &&
        getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.createdAt == request.time;
    }

    // Only the Worker's least-privilege OAuth identity may write trusted records.
    // Direct clients cannot forge confirmations or enumerate private metadata.
    match /photo_objects/{photoId} { allow read, write: if false; }

    match /job_evidence/{requestId} {
      allow get: if hasActiveSession() && (isSuperAdmin() ||
        (isVerifiedCustomer() && serviceRequestData(requestId).customerId == request.auth.uid) ||
        (isVerifiedApprovedTechnician() && requestTechnicianMatches(serviceRequestData(requestId), request.auth.uid)));
      allow list, delete: if false;
      allow create, update: if hasActiveSession() && validJobEvidence(requestId);
    }
    match /service_requests/{requestId} {
      allow create: if hasActiveSession() && validCustomerRequestCreate(requestId);
      allow read: if hasActiveSession() &&
        (
          isSuperAdmin() ||
          resource.data.customerId == request.auth.uid ||
          (
            requestTechnicianMatches(resource.data, request.auth.uid) &&
            isApprovedTechnicianId(request.auth.uid)
          )
        );
      allow update: if hasActiveSession() && (validCustomerRequestCancel(requestId) ||
        validTechnicianRequestStatusUpdate(requestId) || validWorkTimerUpdate());
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if hasActiveSession() && validRequestNotificationCreate(notificationId);
      allow read: if hasActiveSession() &&
        resource.data.userId == request.auth.uid;
      allow update: if hasActiveSession() && validNotificationReadUpdate();
      allow delete: if false;
    }

    match /system_messages/{messageId} {
      allow create: if hasActiveSession() && validSystemMessageCreate();
      allow read: if hasActiveSession() && canReadSystemMessage();
      allow update, delete: if false;
    }

    match /message_reads/{readId} {
      allow read: if hasActiveSession() &&
        resource.data.userId == request.auth.uid;
      allow create, update: if hasActiveSession() && validMessageReadWrite(readId);
      allow delete: if false;
    }

    match /service_reviews/{reviewId} {
      allow create: if hasActiveSession() && validReviewCreate(reviewId);
      allow read: if hasActiveSession() && canReadServiceReview();
      allow update, delete: if false;
    }

    match /account_lifecycle_locks/{targetUid} {
      allow read, write: if false;
    }
    match /account_lifecycle_requests/{requestId} {
      allow read, write: if false;
    }

    // Provisioning reservations and delivery receipts are server-only.
    match /dispatcher_provisioning_operations/{operationId} {
      allow read, write: if false;
    }
    match /dispatcher_provisioning_emails/{emailHash} {
      allow read, write: if false;
    }
    match /dispatcher_invitation_deliveries/{userId} {
      allow read, write: if false;
    }

    match /audit_logs/{auditLogId} {
      allow read: if hasActiveSession() && isSuperAdmin();
      allow create: if hasActiveSession() && validSystemMessageAuditCreate();
      allow update, delete: if false;
    }
  }
}

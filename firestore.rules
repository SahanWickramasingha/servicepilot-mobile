rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.role;
    }

    function userAccountStatus(userId) {
      return get(
        /databases/$(database)/documents/users/$(userId)
      ).data.accountStatus;
    }

    function userHasActiveAccount(userId) {
      return !get(
        /databases/$(database)/documents/users/$(userId)
      ).data.keys().hasAny(["accountStatus"]) ||
        userAccountStatus(userId) == "active";
    }

    function profileHasActiveAccount(data) {
      return !data.keys().hasAny(["accountStatus"]) ||
        data.accountStatus == "active";
    }

    function isSuperAdmin() {
      return signedIn() &&
        userRole(request.auth.uid) == "super_admin" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isActiveSuperAdmin() {
      return signedIn() &&
        userRole(request.auth.uid) == "super_admin" &&
        userAccountStatus(request.auth.uid) == "active";
    }

    function isActiveDispatcher() {
      return signedIn() &&
        userRole(request.auth.uid) == "dispatcher" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isPublicRegistrationRole() {
      return request.resource.data.role in [
        "customer",
        "technician"
      ];
    }

    function authEmailMatchesProfile() {
      return request.auth.token.email is string &&
        request.resource.data.email == request.auth.token.email;
    }

    function hasRequiredUserFields() {
      return request.resource.data.keys().hasAll([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyCustomerCreateFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyTechnicianCreateFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "fullName",
        "email",
        "phone",
        "address",
        "role",
        "accountStatus",
        "emailVerified",
        "specialization",
        "experience",
        "qualifications",
        "certifications",
        "serviceAreas",
        "serviceDivision",
        "technicianApprovalStatus",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasRequiredTechnicianCreateFields() {
      return request.resource.data.keys().hasAll([
        "specialization",
        "experience",
        "qualifications",
        "certifications",
        "serviceDivision",
        "technicianApprovalStatus"
      ]);
    }

    function validPublicUserCreate(userId) {
      return isOwner(userId) &&
        hasRequiredUserFields() &&
        request.resource.data.uid == userId &&
        authEmailMatchesProfile() &&
        isPublicRegistrationRole() &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.emailVerified == false &&
        (
          (
            request.resource.data.role == "customer" &&
            hasOnlyCustomerCreateFields()
          ) ||
          (
            request.resource.data.role == "technician" &&
            hasOnlyTechnicianCreateFields() &&
            hasRequiredTechnicianCreateFields() &&
            request.resource.data.technicianApprovalStatus == "pending"
          )
        );
    }

    function validSuperAdminDispatcherCreate(userId) {
      return isSuperAdmin() &&
        request.resource.data.keys().hasOnly([
          "uid",
          "dispatcherId",
          "fullName",
          "email",
          "role",
          "accountStatus",
          "invitationStatus",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "uid",
          "dispatcherId",
          "fullName",
          "email",
          "role",
          "accountStatus",
          "invitationStatus",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.dispatcherId is string &&
        request.resource.data.dispatcherId.size() > 0 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.role == "dispatcher" &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.invitationStatus == "pending" &&
        request.resource.data.createdBy == request.auth.uid;
    }

    function ownerMutableFieldsOnly() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "fullName",
          "phone",
          "address",
          "specialization",
          "experience",
          "qualifications",
          "certifications",
          "serviceAreas",
          "serviceDivision",
          "emailVerified",
          "updatedAt"
        ]);
    }

    function validOwnerUpdate(userId) {
      return isOwner(userId) &&
        ownerMutableFieldsOnly() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        (
          !request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasAny(["emailVerified"]) ||
          (
            resource.data.emailVerified == false &&
            request.resource.data.emailVerified == true &&
            request.auth.token.email_verified == true
          )
        ) &&
        !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            "uid",
            "role",
            "technicianApprovalStatus",
            "reviewedBy",
            "reviewedAt",
            "rejectionReason"
          ]);
    }

    function validSuperAdminAccountDisable() {
      return profileHasActiveAccount(resource.data) &&
        request.resource.data.accountStatus == "disabled" &&
        request.resource.data.disabledBy == request.auth.uid &&
        request.resource.data.disabledAt is timestamp &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAll([
            "accountStatus",
            "disabledAt",
            "disabledBy",
            "updatedAt"
          ]);
    }

    function validSuperAdminAccountEnable() {
      return resource.data.accountStatus == "disabled" &&
        request.resource.data.accountStatus == "active" &&
        request.resource.data.enabledBy == request.auth.uid &&
        request.resource.data.enabledAt is timestamp &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAll([
            "accountStatus",
            "enabledAt",
            "enabledBy",
            "updatedAt"
          ]);
    }

    function validSuperAdminAccountDelete() {
      return resource.data.accountStatus != "deleted" &&
        request.resource.data.accountStatus == "deleted" &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.deletedAt is timestamp &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAll([
            "accountStatus",
            "deletedAt",
            "deletedBy",
            "updatedAt"
          ]);
    }

    function validSuperAdminAccountLifecycleUpdate() {
      return isSuperAdmin() &&
        resource.data.role in [
          "customer",
          "technician",
          "dispatcher"
        ] &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "accountStatus",
            "disabledAt",
            "disabledBy",
            "enabledAt",
            "enabledBy",
            "deletedAt",
            "deletedBy",
            "updatedAt"
          ]) &&
        (
          validSuperAdminAccountDisable() ||
          validSuperAdminAccountEnable() ||
          validSuperAdminAccountDelete()
        );
    }

    function validDispatcherTechnicianReview() {
      return isActiveDispatcher() &&
        resource.data.role == "technician" &&
        resource.data.technicianApprovalStatus == "pending" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "technicianApprovalStatus",
            "reviewedBy",
            "reviewedAt",
            "rejectionReason",
            "updatedAt"
          ]) &&
        request.resource.data.technicianApprovalStatus in [
          "approved",
          "rejected"
        ] &&
        (
          request.resource.data.technicianApprovalStatus == "approved" ||
          (
            request.resource.data.technicianApprovalStatus == "rejected" &&
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          )
        ) &&
        request.resource.data.reviewedBy == request.auth.uid;
    }

    function validDispatcherInvitationAccept(userId) {
      return isOwner(userId) &&
        resource.data.role == "dispatcher" &&
        resource.data.invitationStatus == "pending" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.dispatcherId == resource.data.dispatcherId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "invitationStatus",
            "updatedAt"
          ]) &&
        request.resource.data.invitationStatus == "accepted";
    }

    function validSuperAdminFailedDispatcherCleanup() {
      return isSuperAdmin() &&
        resource.data.role == "dispatcher" &&
        resource.data.invitationStatus == "pending" &&
        resource.data.createdBy == request.auth.uid;
    }

    function isApprovedTechnicianProfile() {
      return resource.data.role == "technician" &&
        resource.data.technicianApprovalStatus == "approved";
    }

    function isTechnicianProfile() {
      return resource.data.role == "technician";
    }

    function canGetUserProfile(userId) {
      return isOwner(userId) ||
        isSuperAdmin() ||
        (
          isActiveDispatcher() &&
          isTechnicianProfile()
        ) ||
        (
          isVerifiedCustomer() &&
          isApprovedTechnicianProfile()
        );
    }

    function canListUserProfiles() {
      return isSuperAdmin() ||
        (
          isActiveDispatcher() &&
          isTechnicianProfile()
        ) ||
        (
          isVerifiedCustomer() &&
          isApprovedTechnicianProfile()
        );
    }

    function isCustomer() {
      return signedIn() &&
        userRole(request.auth.uid) == "customer";
    }

    function isActiveCustomer() {
      return isCustomer() &&
        userHasActiveAccount(request.auth.uid);
    }

    function isActiveTechnician() {
      return signedIn() &&
        userRole(request.auth.uid) == "technician" &&
        userHasActiveAccount(request.auth.uid);
    }

    function isVerifiedCustomer() {
      return isActiveCustomer() &&
        request.auth.token.email_verified == true;
    }

    function hasRequiredRequestCreateFields() {
      return request.resource.data.keys().hasAll([
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "technicianId",
        "technicianName",
        "serviceCategory",
        "title",
        "description",
        "address",
        "serviceArea",
        "division",
        "preferredDate",
        "preferredTime",
        "scheduledAt",
        "priority",
        "status",
        "imageUrls",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasOnlyCustomerRequestCreateFields() {
      return request.resource.data.keys().hasOnly([
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "technicianId",
        "technicianName",
        "serviceCategory",
        "title",
        "description",
        "address",
        "serviceArea",
        "division",
        "preferredDate",
        "preferredTime",
        "scheduledAt",
        "priority",
        "status",
        "imageUrls",
        "createdAt",
        "updatedAt"
      ]);
    }

    function isApprovedTechnicianId(technicianId) {
      return exists(
        /databases/$(database)/documents/users/$(technicianId)
      ) &&
        get(
          /databases/$(database)/documents/users/$(technicianId)
        ).data.role == "technician" &&
        get(
          /databases/$(database)/documents/users/$(technicianId)
        ).data.technicianApprovalStatus == "approved" &&
        profileHasActiveAccount(
          get(
            /databases/$(database)/documents/users/$(technicianId)
          ).data
        );
    }

    function validLifecycleAuditAction() {
      return (
        request.resource.data.targetRole == "customer" &&
        request.resource.data.action in [
          "SUPER_ADMIN_DISABLED_CUSTOMER",
          "SUPER_ADMIN_ENABLED_CUSTOMER",
          "SUPER_ADMIN_DELETED_CUSTOMER"
        ]
      ) ||
      (
        request.resource.data.targetRole == "technician" &&
        request.resource.data.action in [
          "SUPER_ADMIN_DISABLED_TECHNICIAN",
          "SUPER_ADMIN_ENABLED_TECHNICIAN",
          "SUPER_ADMIN_DELETED_TECHNICIAN"
        ]
      ) ||
      (
        request.resource.data.targetRole == "dispatcher" &&
        request.resource.data.action in [
          "SUPER_ADMIN_DISABLED_DISPATCHER",
          "SUPER_ADMIN_ENABLED_DISPATCHER",
          "SUPER_ADMIN_DELETED_DISPATCHER"
        ]
      );
    }

    function validSuperAdminLifecycleAuditCreate() {
      return isSuperAdmin() &&
        request.resource.data.keys().hasOnly([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetRole",
          "targetType",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetRole",
          "targetType",
          "createdAt"
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == "super_admin" &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        exists(
          /databases/$(database)/documents/users/$(request.resource.data.targetUid)
        ) &&
        get(
          /databases/$(database)/documents/users/$(request.resource.data.targetUid)
        ).data.role == request.resource.data.targetRole &&
        request.resource.data.targetRole in [
          "customer",
          "technician",
          "dispatcher"
        ] &&
        request.resource.data.targetType == "user" &&
        request.resource.data.createdAt is timestamp &&
        validLifecycleAuditAction();
    }

    function validSystemMessageAuditCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetType",
          "messageId",
          "metadata",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "action",
          "actorUid",
          "actorRole",
          "targetUid",
          "targetType",
          "messageId",
          "metadata",
          "createdAt"
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorRole == userRole(request.auth.uid) &&
        (
          (
            isActiveSuperAdmin() &&
            request.resource.data.actorRole == "super_admin" &&
            request.resource.data.action == "SUPER_ADMIN_SENT_SYSTEM_MESSAGE"
          ) ||
          (
            isActiveDispatcher() &&
            request.resource.data.actorRole == "dispatcher" &&
            request.resource.data.action == "DISPATCHER_SENT_SYSTEM_MESSAGE"
          )
        ) &&
        request.resource.data.targetType == "system_message" &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid.size() > 0 &&
        request.resource.data.messageId == request.resource.data.targetUid &&
        request.resource.data.metadata.keys().hasOnly([
          "messageId",
          "audienceRoles",
          "priority"
        ]) &&
        request.resource.data.metadata.messageId ==
          request.resource.data.messageId &&
        request.resource.data.metadata.audienceRoles is list &&
        request.resource.data.metadata.audienceRoles.size() > 0 &&
        request.resource.data.metadata.priority in [
          "normal",
          "important",
          "critical"
        ] &&
        request.resource.data.createdAt is timestamp &&
        (
          (
            request.resource.data.actorRole == "super_admin" &&
            request.resource.data.metadata.audienceRoles.hasOnly([
              "customer",
              "technician",
              "dispatcher"
            ])
          ) ||
          (
            request.resource.data.actorRole == "dispatcher" &&
            request.resource.data.metadata.audienceRoles.hasOnly([
              "technician",
              "super_admin"
            ])
          )
        );
    }

    function validCustomerRequestCreate() {
      return isVerifiedCustomer() &&
        hasRequiredRequestCreateFields() &&
        hasOnlyCustomerRequestCreateFields() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.technicianId is string &&
        request.resource.data.technicianName is string &&
        isApprovedTechnicianId(request.resource.data.technicianId) &&
        request.resource.data.status == "requested" &&
        request.resource.data.scheduledAt is timestamp &&
        request.resource.data.priority in ["normal", "urgent"] &&
        request.resource.data.imageUrls is list;
    }

    function validCustomerRequestCancel() {
      return isVerifiedCustomer() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.status in ["requested", "pending"] &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.technicianId == resource.data.technicianId &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancelledBy == "customer" &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "updatedAt",
            "cancelledAt",
            "cancelledBy"
          ]);
    }

    function validTechnicianRequestStatusUpdate() {
      return signedIn() &&
        isApprovedTechnicianId(request.auth.uid) &&
        resource.data.technicianId == request.auth.uid &&
        request.resource.data.technicianId == resource.data.technicianId &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "acceptedAt",
            "rejectedAt",
            "startedAt",
            "completedAt",
            "technicianCancelledAt",
            "cancelledBy",
            "rejectionReason",
            "technicianCancellationReason",
            "updatedAt"
          ]) &&
        (
          (
            resource.data.status in ["requested", "pending"] &&
            request.resource.data.status == "accepted"
          ) ||
          (
            resource.data.status in ["requested", "pending"] &&
            request.resource.data.status == "rejected" &&
            request.resource.data.rejectionReason is string &&
            request.resource.data.rejectionReason.size() > 0
          ) ||
          (
            resource.data.status in ["accepted", "assigned"] &&
            request.resource.data.status == "in_progress"
          ) ||
          (
            resource.data.status in ["accepted", "assigned"] &&
            request.resource.data.status == "cancelled" &&
            request.resource.data.cancelledBy == "technician" &&
            request.resource.data.technicianCancellationReason is string &&
            request.resource.data.technicianCancellationReason.size() > 0
          ) ||
          (
            resource.data.status == "in_progress" &&
            request.resource.data.status == "completed"
          )
        );
    }

    function validNotificationReadUpdate() {
      return signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["read", "updatedAt"]) &&
        request.resource.data.read == true;
    }

    function validNotificationBaseCreate() {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "userId",
          "type",
          "title",
          "message",
          "requestId",
          "priority",
          "read",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "type",
          "title",
          "message",
          "requestId",
          "priority",
          "read",
          "createdAt"
        ]) &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.requestId is string &&
        request.resource.data.requestId.size() > 0 &&
        request.resource.data.priority in [
          "normal",
          "important",
          "critical"
        ] &&
        request.resource.data.read == false &&
        request.resource.data.createdAt is timestamp &&
        exists(
          /databases/$(database)/documents/service_requests/$(request.resource.data.requestId)
        );
    }

    function notificationRequest() {
      return get(
        /databases/$(database)/documents/service_requests/$(request.resource.data.requestId)
      ).data;
    }

    function validRequestNotificationCreate() {
      return validNotificationBaseCreate() &&
        (
          (
            request.resource.data.type == "new_customer_request" &&
            notificationRequest().customerId == request.auth.uid &&
            notificationRequest().technicianId == request.resource.data.userId
          ) ||
          (
            request.resource.data.type == "customer_cancelled_request" &&
            notificationRequest().customerId == request.auth.uid &&
            notificationRequest().technicianId == request.resource.data.userId &&
            notificationRequest().status == "cancelled"
          ) ||
          (
            request.resource.data.type in [
              "technician_accepted_request",
              "technician_rejected_request",
              "job_started",
              "technician_cancelled_job",
              "job_completed"
            ] &&
            notificationRequest().technicianId == request.auth.uid &&
            notificationRequest().customerId == request.resource.data.userId &&
            (
              (
                request.resource.data.type == "technician_accepted_request" &&
                notificationRequest().status == "accepted"
              ) ||
              (
                request.resource.data.type == "technician_rejected_request" &&
                notificationRequest().status == "rejected"
              ) ||
              (
                request.resource.data.type == "job_started" &&
                notificationRequest().status == "in_progress"
              ) ||
              (
                request.resource.data.type == "technician_cancelled_job" &&
                notificationRequest().status == "cancelled" &&
                notificationRequest().cancelledBy == "technician"
              ) ||
              (
                request.resource.data.type == "job_completed" &&
                notificationRequest().status == "completed"
              )
            )
          ) ||
          (
            request.resource.data.type == "new_review" &&
            notificationRequest().customerId == request.auth.uid &&
            notificationRequest().technicianId == request.resource.data.userId &&
            exists(
              /databases/$(database)/documents/service_reviews/$(request.resource.data.requestId + "_" + request.auth.uid)
            )
          )
        );
    }

    function isOwnCompletedRequest(requestId) {
      return exists(
        /databases/$(database)/documents/service_requests/$(requestId)
      ) &&
        get(
          /databases/$(database)/documents/service_requests/$(requestId)
        ).data.customerId == request.auth.uid &&
        get(
          /databases/$(database)/documents/service_requests/$(requestId)
        ).data.status == "completed";
    }

    function validReviewCreate(reviewId) {
      return isVerifiedCustomer() &&
        request.resource.data.keys().hasOnly([
          "requestId",
          "customerId",
          "technicianId",
          "rating",
          "comment",
          "createdAt"
        ]) &&
        request.resource.data.customerId == request.auth.uid &&
        reviewId ==
          request.resource.data.requestId + "_" + request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.technicianId is string &&
        isOwnCompletedRequest(request.resource.data.requestId);
    }

    function validSystemMessageFields() {
      return request.resource.data.keys().hasOnly([
        "senderId",
        "senderName",
        "senderRole",
        "audienceRoles",
        "title",
        "message",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "senderId",
        "senderName",
        "senderRole",
        "audienceRoles",
        "title",
        "message",
        "priority",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.senderId == request.auth.uid &&
      request.resource.data.senderRole == userRole(request.auth.uid) &&
      request.resource.data.senderName ==
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.fullName &&
      request.resource.data.audienceRoles is list &&
      request.resource.data.audienceRoles.size() > 0 &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.message is string &&
      request.resource.data.message.size() > 0 &&
      request.resource.data.priority in [
        "normal",
        "important",
        "critical"
      ] &&
      request.resource.data.status in [
        "active",
        "sent"
      ] &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp;
    }

    function validSystemMessageCreate() {
      return validSystemMessageFields() &&
        (
          (
            isActiveSuperAdmin() &&
            request.resource.data.audienceRoles.hasOnly([
              "customer",
              "technician",
              "dispatcher"
            ])
          ) ||
          (
            isActiveDispatcher() &&
            request.resource.data.audienceRoles.hasOnly([
              "technician",
              "super_admin"
            ])
          )
        );
    }

    function isPublishedSystemMessage(data) {
      return data.status == "active" ||
        data.status == "sent";
    }

    function isCustomerSystemMessageRecipient(data) {
      return isActiveCustomer() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["customer"]);
    }

    function isTechnicianSystemMessageRecipient(data) {
      return isActiveTechnician() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["technician"]);
    }

    function isDispatcherSystemMessageRecipient(data) {
      return isActiveDispatcher() &&
        isPublishedSystemMessage(data) &&
        data.audienceRoles.hasAny(["dispatcher"]);
    }

    function canReadSystemMessageAsRecipient(data) {
      return signedIn() &&
        (
          isCustomerSystemMessageRecipient(data) ||
          isTechnicianSystemMessageRecipient(data) ||
          isDispatcherSystemMessageRecipient(data)
        );
    }

    function canReadOwnDispatcherSystemMessage(data) {
      return isActiveDispatcher() &&
        isPublishedSystemMessage(data) &&
        data.senderId == request.auth.uid &&
        data.senderRole == "dispatcher";
    }

    function canReadSystemMessage() {
      return isActiveSuperAdmin() ||
        canReadSystemMessageAsRecipient(resource.data) ||
        canReadOwnDispatcherSystemMessage(resource.data);
    }

    function canReadReferencedSystemMessage(messageId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/system_messages/$(messageId)
        ) &&
        canReadSystemMessageAsRecipient(
          get(
            /databases/$(database)/documents/system_messages/$(messageId)
          ).data
        );
    }

    function validMessageReadWrite(readId) {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          "userId",
          "messageId",
          "readAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "messageId",
          "readAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        readId == request.auth.uid + "_" + request.resource.data.messageId &&
        request.resource.data.messageId is string &&
        request.resource.data.messageId.size() > 0 &&
        request.resource.data.readAt is timestamp &&
        canReadReferencedSystemMessage(request.resource.data.messageId);
    }

    match /users/{userId} {
      allow create: if validPublicUserCreate(userId) ||
        validSuperAdminDispatcherCreate(userId);
      allow get: if canGetUserProfile(userId);
      allow list: if canListUserProfiles();
      allow update: if validOwnerUpdate(userId) ||
        validSuperAdminAccountLifecycleUpdate() ||
        validDispatcherInvitationAccept(userId) ||
        validDispatcherTechnicianReview();
      allow delete: if validSuperAdminFailedDispatcherCleanup();
    }

    match /service_requests/{requestId} {
      allow create: if validCustomerRequestCreate();
      allow read: if signedIn() &&
        (
          isSuperAdmin() ||
          resource.data.customerId == request.auth.uid ||
          (
            resource.data.technicianId == request.auth.uid &&
            isApprovedTechnicianId(request.auth.uid)
          )
        );
      allow update: if validCustomerRequestCancel() ||
        validTechnicianRequestStatusUpdate();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if validRequestNotificationCreate();
      allow read: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow update: if validNotificationReadUpdate();
      allow delete: if false;
    }

    match /system_messages/{messageId} {
      allow create: if validSystemMessageCreate();
      allow read: if canReadSystemMessage();
      allow update, delete: if false;
    }

    match /message_reads/{readId} {
      allow read: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow create, update: if validMessageReadWrite(readId);
      allow delete: if false;
    }

    match /service_reviews/{reviewId} {
      allow create: if validReviewCreate(reviewId);
      allow read: if signedIn() &&
        (
          isSuperAdmin() ||
          resource.data.customerId == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /audit_logs/{auditLogId} {
      allow read: if isSuperAdmin();
      allow create: if validSuperAdminLifecycleAuditCreate() ||
        validSystemMessageAuditCreate();
      allow update, delete: if false;
    }
  }
}

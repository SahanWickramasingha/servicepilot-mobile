{
  "expo": {
    "name": "ServicePilot",
    "slug": "servicepilot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/servicepilot-logo.png",
    "scheme": "servicepilotmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/servicepilot-logo.png",
        "backgroundColor": "#06101D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/servicepilot-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/servicepilot-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#06101D",
          "dark": {
            "image": "./assets/images/servicepilot-logo.png",
            "backgroundColor": "#06101D"
          }
        }
      ],
      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
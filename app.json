{
  "expo": {
    "name": "ServicePilot",
    "slug": "servicepilot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/servicepilot-logo.png",
    "scheme": "servicepilotmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.CALL_PHONE",
        "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO", "android.permission.READ_CONTACTS", "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS", "android.permission.SEND_SMS", "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG", "android.permission.ACCESS_BACKGROUND_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.sahanwickramasingha.servicepilot",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/servicepilot-logo.png",
        "backgroundColor": "#06101D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/servicepilot-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your ServicePilot review or assigned service job.",
          "cameraPermission": "Take service evidence photos for your assigned ServicePilot job.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/servicepilot-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#06101D",
          "dark": {
            "image": "./assets/images/servicepilot-logo.png",
            "backgroundColor": "#06101D"
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your location while using ServicePilot. Customers see an approximate area; your active job Customer can see your precise location.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b04d5f66-1b75-4626-b6f0-77d3d7ccf529"
      }
    },
    "owner": "sahanwickramasingha2003"
  }
}

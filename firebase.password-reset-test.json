{
  "hosting": {
    "public": ".expo/password-reset-emulator",
    "cleanUrls": true,
    "headers": [{ "regex": "^[/\\\\]auth[/\\\\].*", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" }
    ] }]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9197 },
    "hosting": { "host": "127.0.0.1", "port": 5008 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}

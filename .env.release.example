# Public mobile build settings only. Copy to an ignored .env.release.local for
# offline checking; create these separately in EAS preview and production.
# Values deliberately blank until the release owner supplies real identities.
SERVICEPILOT_RELEASE=1
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=0
EXPO_ANDROID_PACKAGE=
EXPO_EAS_PROJECT_ID=
EXPO_OWNER=
EXPO_PUBLIC_BOOKING_API_URL=
# Actual servicepilot-booking Worker HTTPS origin from Wrangler, no path/query.
# See scripts/BOOKING_WORKER_DEPLOYMENT.md. Keep the existing photo origin below.
EXPO_PUBLIC_PHOTO_API_URL=
GOOGLE_MAPS_ANDROID_API_KEY=
# Never add service-account JSON, private keys, SMTP passwords or server tokens.

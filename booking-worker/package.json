{
  "name": "servicepilot-booking-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8791",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:emulator": "tsx --test test/firestore.emulator.ts",
    "profile:free": "tsx scripts/profile-free.ts",
    "build": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "wrangler": "4.155.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.2-beta"
  }
}
